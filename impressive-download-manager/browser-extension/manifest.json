{
  "manifest_version": 3,
  "name": "Impressive Download Manager Capture Engine",
  "version": "1.0.0",
  "description": "Intercepts download requests and captures online videos for Impressive Download Manager.",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "cookies",
    "webRequest",
    "nativeMessaging"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "idm-extension@impressive.com",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-media.js",
        "youtube-page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "youtube-relay.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media-choices.js",
        "hls.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
