{
  "manifest_version": 3,
  "name": "Impressive Download Manager Capture Engine",
  "version": "1.0.0",
  "description": "Intercepts download requests and captures online videos for Impressive Download Manager.",
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
