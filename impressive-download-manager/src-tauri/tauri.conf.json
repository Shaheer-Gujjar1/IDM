{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "impressive-download-manager",
  "version": "0.8.0",
  "identifier": "com.shaheer.impressive-download-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IDM (Impressive Download Manager)",
        "width": 800,
        "height": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "High-performance multi-threaded download manager",
    "longDescription": "Impressive Download Manager (IDM) is an advanced, high-performance download manager featuring multi-segmented downloads, liquid progress UI, and seamless browser integration.",
    "category": "Network",
    "copyright": "Copyright © 2026 Impressive Download Manager",
    "createUpdaterArtifacts": true,
    "targets": ["deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [],
        "section": "net",
        "postRemoveScript": "../scripts/postrm.sh"
      },
      "rpm": {
        "postRemoveScript": "../scripts/postrm.sh"
      }
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png",
        "sidebarImage": "icons/128x128@2x.png"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1NEE1MzBCRjhERTNGREQKUldUZFA5NzRDMU5LNVR1dUhZRkxyWlI4VGZ4QXdGbEtNWHJRNkEvbStkYXhKbER2cVc1NWFDcVcK",
      "endpoints": [
        "https://github.com/Shaheer-Gujjar1/IDM/releases/latest/download/latest.json"
      ]
    }
  }
}
